{
  "name": "@reef-ui/theme",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./src/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxzzz/reef-ui.git"
  },
  "homepage": "https://github.com/jxzzz/reef-ui#readme",
  "bugs": {
    "url": "https://github.com/jxzzz/reef-ui/issues"
  },
  "description": "Reef UI design tokens —— CSS 变量主题（design tokens as CSS variables）",
  "keywords": [
    "design-tokens",
    "css-variables",
    "theme",
    "ui"
  ]
}
