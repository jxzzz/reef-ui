{
  "name": "@reef-ui/components",
  "version": "0.8.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "dependencies": {
    "@reef-ui/theme": "workspace:*",
    "@reef-ui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^14.2.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxzzz/reef-ui.git"
  },
  "homepage": "https://github.com/jxzzz/reef-ui#readme",
  "bugs": {
    "url": "https://github.com/jxzzz/reef-ui/issues"
  },
  "description": "Reef UI React 组件库 —— 中后台场景的开源组件（React component library for admin dashboards）",
  "keywords": [
    "react",
    "components",
    "ui",
    "component-library",
    "admin",
    "dashboard",
    "typescript",
    "react-components"
  ],
  "size-limit": [
    {
      "name": "JS (gzip)",
      "path": "dist/index.js",
      "gzip": true,
      "limit": "40 kB"
    }
  ]
}
